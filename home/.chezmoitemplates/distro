{{- /* Usage:
{{- $distro := (includeTemplate "distro" . | fromToml).distro -}}
{{- if eq $distro "darwin" -}}
...
{{- end }}
*/ -}}

distro = {{- " " -}}
{{- if eq .chezmoi.os "darwin" -}}
  "darwin"
{{- else if eq .chezmoi.os "linux" -}}
{{-   if and (eq .chezmoi.osRelease.id "amzn") (eq .chezmoi.osRelease.version "2") -}}
        "al2"
{{-   else if and (eq .chezmoi.osRelease.id "amzn") (eq .chezmoi.osRelease.version "2023") -}}
        "al2023"
{{-   else -}}
        "linux"
{{-   end -}}
{{- else -}}
{{-   fail (print .chezmoi.os " is currently not supported") -}}
{{- end -}}
